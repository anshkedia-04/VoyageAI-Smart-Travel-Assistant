# Required for LLM agent execution (configure at least one provider)
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional live travel data tools (agent degrades gracefully if omitted)
OPENWEATHERMAP_API_KEY=
GEOAPIFY_API_KEY=
TAVILY_API_KEY=
EXCHANGE_RATE_API_KEY=

# Frontend / Backend deployment settings
VOYAGEAI_BACKEND_URL=http://localhost:8000
CORS_ORIGINS=*
LOG_LEVEL=INFO
